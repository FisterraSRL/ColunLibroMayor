{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build-vercel.mjs",
  "installCommand": "npx --yes pnpm@11.25.0 install --frozen-lockfile --ignore-scripts",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {"api/index.mjs": {"maxDuration": 300}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index"}],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "Cache-Control", "value": "no-store"},
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Referrer-Policy", "value": "no-referrer"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'"}
  ]}]
}
